<div class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-green-50">
  <div class="w-full px-4 sm:px-6 lg:px-8 py-6">
    <!-- Header Section -->
    <div class="mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">New Transaction</h1>
          <p class="mt-2 text-sm sm:text-base text-gray-600">Create a new financial transaction</p>
        </div>
        <div class="flex space-x-3">
          <%= link_to transactions_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors duration-200" do %>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Back to Transactions
          <% end %>
        </div>
      </div>
    </div>

    <!-- Transaction Form -->
    <div class="max-w-4xl mx-auto">
      <%= form_with(model: @transaction, local: true, class: "space-y-6") do |form| %>
        <% if @transaction.errors.any? %>
          <div class="bg-red-50 border border-red-200 rounded-lg p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">
                  <%= pluralize(@transaction.errors.count, "error") %> prohibited this transaction from being saved:
                </h3>
                <div class="mt-2 text-sm text-red-700">
                  <ul class="list-disc pl-5 space-y-1">
                    <% @transaction.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Basic Information -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Basic Information</h3>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="sm:col-span-2">
              <%= form.label :description, class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.text_field :description, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors duration-200", placeholder: "Enter transaction description" %>
              <p class="mt-1 text-xs text-gray-500">Brief description of the transaction</p>
            </div>

            <div>
              <%= form.label :transaction_type, class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.select :transaction_type, [['Income', 0], ['Expense', 1], ['Transfer', 2]], { prompt: 'Select transaction type' }, { class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors duration-200" } %>
            </div>

            <div>
              <%= form.label :transaction_date, class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.date_field :transaction_date, value: Date.current, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors duration-200" %>
            </div>

            <div>
              <%= form.label :reference_number, class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.text_field :reference_number, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors duration-200", placeholder: "Optional reference number" %>
              <p class="mt-1 text-xs text-gray-500">Check number, transaction ID, etc.</p>
            </div>

            <div>
              <%= form.label :status, class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.select :status, [['Pending', 0], ['Completed', 1], ['Cancelled', 2]], { selected: 1 }, { class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors duration-200" } %>
            </div>
          </div>
        </div>

        <!-- Financial Details -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Financial Details</h3>
          
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            <div>
              <%= form.label :amount, class: "block text-sm font-medium text-gray-700 mb-2" %>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <span class="text-gray-500 sm:text-sm">₹</span>
                </div>
                <%= form.number_field :amount, step: "0.01", class: "w-full pl-8 pr-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors duration-200", placeholder: "0.00" %>
              </div>
              <p class="mt-1 text-xs text-gray-500">Positive for income, negative for expense</p>
            </div>

            <div>
              <%= form.label :nav, "NAV (Net Asset Value)", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <span class="text-gray-500 sm:text-sm">₹</span>
                </div>
                <%= form.number_field :nav, step: "0.01", min: "0", class: "w-full pl-8 pr-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors duration-200", placeholder: "0.00" %>
              </div>
              <p class="mt-1 text-xs text-gray-500">For investment transactions</p>
            </div>

            <div>
              <%= form.label :units, class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.number_field :units, step: "0.0001", min: "0", class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors duration-200", placeholder: "0.0000" %>
              <p class="mt-1 text-xs text-gray-500">Number of units purchased/sold</p>
            </div>
          </div>
        </div>

        <!-- Additional Information -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Additional Information</h3>
          
          <div>
            <%= form.label :notes, class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.text_area :notes, rows: 4, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors duration-200", placeholder: "Additional notes about the transaction..." %>
            <p class="mt-1 text-xs text-gray-500">Optional additional details</p>
          </div>
        </div>

        <!-- Form Actions -->
        <div class="flex justify-end space-x-3 pt-6">
          <%= link_to transactions_path, class: "px-6 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors duration-200" do %>
            Cancel
          <% end %>
          <%= form.submit "Create Transaction", class: "px-6 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors duration-200" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
// Auto-calculate amount based on NAV and units
document.addEventListener('DOMContentLoaded', function() {
  const navField = document.getElementById('transaction_nav');
  const unitsField = document.getElementById('transaction_units');
  const amountField = document.getElementById('transaction_amount');
  
  function calculateAmount() {
    const nav = parseFloat(navField.value) || 0;
    const units = parseFloat(unitsField.value) || 0;
    const amount = nav * units;
    
    if (amount > 0) {
      amountField.value = amount.toFixed(2);
    }
  }
  
  navField.addEventListener('input', calculateAmount);
  unitsField.addEventListener('input', calculateAmount);
  
  // Set default date to today
  const dateField = document.getElementById('transaction_transaction_date');
  if (dateField && !dateField.value) {
    dateField.value = new Date().toISOString().split('T')[0];
  }
});
</script>
